{
  "name": "mga-setlist-oracle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "fetch:setlists": "node --no-warnings --env-file-if-exists=.env.local scripts/fetch-setlists.ts",
    "fetch:setlists:history": "node --no-warnings --env-file-if-exists=.env.local scripts/fetch-setlists.ts --since 2015-01-01 --out data/setlists-history.json",
    "build:stats": "node --no-warnings scripts/build-song-stats.ts",
    "build:album-stats": "node --no-warnings scripts/build-album-debut-stats.ts",
    "build:tour-stats": "node --no-warnings scripts/build-tour-stats.ts",
    "test:e2e": "node scripts/e2e-gate.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "screenshot:setlist": "node --no-warnings scripts/screenshot-setlist.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
