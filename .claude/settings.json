{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run dev*)",
      "Bash(npm install)",
      "Bash(node --no-warnings .claude/skills/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git check-ignore*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./jev-api-key)",
      "Bash(cat .env*)",
      "Bash(cat jev-api-key)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
